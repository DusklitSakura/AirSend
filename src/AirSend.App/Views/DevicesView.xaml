<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AirSend.Views.DevicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AirSend.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AirSend.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer x:Name="DevicesScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,8,24,24" Spacing="4">

            <!--  Page header  -->
            <TextBlock
                Margin="4,8,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.DevicesTitle, Mode=OneWay}" />
            <TextBlock
                Margin="4,0,0,10"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.DevicesDescription, Mode=OneWay}"
                TextWrapping="Wrap" />

            <!--  Command row  -->
            <Grid Margin="4,0,4,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    Content="{x:Bind ViewModel.ScanButtonText, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <!--  Device cards  -->
            <ListView
                MaxHeight="340"
                ItemContainerStyle="{StaticResource DeviceItemContainerStyle}"
                ItemsSource="{x:Bind ViewModel.Devices}"
                SelectionMode="None"
                Visibility="{x:Bind local:ViewHelpers.ToVisibility(ViewModel.HasDevices), Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceViewModel">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                CornerRadius="20">
                                <FontIcon
                                    FontSize="18"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="{x:Bind KindGlyph}" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Meta, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="OnDeviceButtonClick"
                                Content="{x:Bind ButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Empty state  -->
            <Border
                Margin="0,4,0,4"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{x:Bind local:ViewHelpers.ToInverseVisibility(ViewModel.HasDevices), Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE767;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.DevicesEmptyTitle, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.DevicesEmptyDescription, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Multi device  -->
            <controls:SettingsCard
                Margin="0,8,0,0"
                Description="{x:Bind ViewModel.MultiDeviceHint, Mode=OneWay}"
                Header="{x:Bind ViewModel.MultiDeviceLabel, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.MultiDevice, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!--  Manual entry  -->
            <controls:SettingsExpander
                Margin="0,4,0,0"
                Description="{x:Bind ViewModel.ManualHint, Mode=OneWay}"
                Header="{x:Bind ViewModel.ManualSummary, Mode=OneWay}">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="{x:Bind ViewModel.ManualEndpointPlaceholder, Mode=OneWay}">
                        <TextBox
                            MinWidth="220"
                            PlaceholderText="{x:Bind ViewModel.ManualEndpointPlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.ManualIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind ViewModel.ManualNamePlaceholder, Mode=OneWay}">
                        <TextBox
                            MinWidth="220"
                            PlaceholderText="{x:Bind ViewModel.ManualNamePlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.ManualName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Description="{x:Bind ViewModel.ManualStatus, Mode=OneWay}">
                        <Button
                            Click="OnAddManualClick"
                            Content="{x:Bind ViewModel.ManualAddText, Mode=OneWay}"
                            IsEnabled="{x:Bind local:ViewHelpers.Not(ViewModel.IsManualBusy), Mode=OneWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
