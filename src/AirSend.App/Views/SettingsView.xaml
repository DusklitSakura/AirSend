<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AirSend.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AirSend.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,8,24,24" Spacing="4">

            <!--  General  -->
            <TextBlock
                Margin="4,12,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.GeneralGroupLabel, Mode=OneWay}" />

            <controls:SettingsCard
                Description="{x:Bind ViewModel.LanguageDescription, Mode=OneWay}"
                Header="{x:Bind ViewModel.LanguageLabel, Mode=OneWay}">
                <ComboBox
                    AutomationProperties.AutomationId="LanguageCombo"
                    AutomationProperties.Name="{x:Bind ViewModel.LanguageLabel, Mode=OneWay}"
                    MinWidth="150"
                    ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                    SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="{x:Bind ViewModel.AutoConnectHint, Mode=OneWay}"
                Header="{x:Bind ViewModel.AutoConnectLabel, Mode=OneWay}">
                <ToggleSwitch
                    AutomationProperties.AutomationId="AutoConnectToggle"
                    AutomationProperties.Name="{x:Bind ViewModel.AutoConnectLabel, Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.AutoConnectEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Description="{x:Bind ViewModel.StartWithWindowsDescription, Mode=OneWay}"
                Header="{x:Bind ViewModel.StartWithWindowsLabel, Mode=OneWay}">
                <ToggleSwitch
                    AutomationProperties.AutomationId="StartWithWindowsToggle"
                    AutomationProperties.Name="{x:Bind ViewModel.StartWithWindowsLabel, Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard Header="{x:Bind ViewModel.AutoConnectDeviceLabel, Mode=OneWay}">
                <ComboBox
                    AutomationProperties.AutomationId="AutoConnectDeviceCombo"
                    AutomationProperties.Name="{x:Bind ViewModel.AutoConnectDeviceLabel, Mode=OneWay}"
                    MinWidth="150"
                    IsEnabled="{x:Bind ViewModel.CanPickAutoConnect, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.AutoConnectOptions}"
                    SelectedIndex="{x:Bind ViewModel.SelectedAutoConnectIndex, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!--  Audio  -->
            <TextBlock
                Margin="4,16,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.AudioGroupLabel, Mode=OneWay}" />

            <controls:SettingsCard
                Description="{x:Bind ViewModel.CaptureSourceHint, Mode=OneWay}"
                Header="{x:Bind ViewModel.CaptureSourceLabel, Mode=OneWay}">
                <ComboBox
                    AutomationProperties.AutomationId="CaptureSourceCombo"
                    AutomationProperties.Name="{x:Bind ViewModel.CaptureSourceLabel, Mode=OneWay}"
                    MinWidth="150"
                    ItemsSource="{x:Bind ViewModel.CaptureSourceOptions}"
                    SelectedIndex="{x:Bind ViewModel.SelectedCaptureIndex, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!--  Logs  -->
            <TextBlock
                Margin="4,16,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.LogsGroupLabel, Mode=OneWay}" />

            <controls:SettingsCard
                Description="{x:Bind ViewModel.LogsHint, Mode=OneWay}"
                Header="{x:Bind ViewModel.LogSummary, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.ToggleLogVisibilityCommand}"
                        Content="{x:Bind ViewModel.LogToggleText, Mode=OneWay}" />
                    <Button Click="OnOpenLogsClick" Content="{x:Bind ViewModel.OpenLogsText, Mode=OneWay}" />
                    <Button Click="OnOpenDataClick" Content="{x:Bind ViewModel.OpenDataText, Mode=OneWay}" />
                </StackPanel>
            </controls:SettingsCard>

            <!--  The log itself stays hidden until the user asks for it.  -->
            <Border
                Margin="0,4,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{x:Bind local:ViewHelpers.ToVisibility(ViewModel.IsLogVisible), Mode=OneWay}">
                <ListView
                    MaxHeight="200"
                    ItemsSource="{x:Bind ViewModel.LogEntries}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="11"
                                Text="{x:Bind}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!--  About  -->
            <TextBlock
                Margin="4,16,0,6"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.AboutLabel, Mode=OneWay}" />

            <controls:SettingsCard
                Description="{x:Bind ViewModel.AboutText, Mode=OneWay}"
                Header="{x:Bind ViewModel.VersionText, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
